# ── 构建产物 ────────────────────────────────────────────
# dist/ 是打包输出：620 MB，含整个 Electron 发行版与上游只读拷贝。
# 需要成品请本地跑 `python electron/pack.py`（约 2~4 分钟）。
/dist/

# ── 依赖与第三方二进制 ──────────────────────────────────
/electron/node_modules/
# aria2c.exe 是 GPLv2 第三方二进制。2026-10-26 移交时改为**入库**：
# 同事 clone 后要能直接打包，且 GPLv2 分发本就要求随附授权文件。
# electron/vendor/aria2/ 下必须有：aria2c.exe + COPYING + LICENSE.OpenSSL + SOURCE-OFFER.txt
__pycache__/
/electron/__pycache__/

# ── 探针缓存 / 抓取样本（体积大，可重跑生成）─────────────
/demo/_imgcache/
/demo/_shots/
/demo/_ext_mods/
/demo/_cp_out.txt
/demo/_actfit_*.json

# ── 版本回退点：v27 起由 git 历史承担 ───────────────────
/demo/*.bak.html
/demo/data.v8.bak.js

# ── 本地过程目录（不属于交付物）─────────────────────────
/_archive/
/_audit/
/_probe/
/_demo_tmp/
# 第三方站点实拍取证，仅本地留证，不对外分发
/_ref/
/_refs/

# ── 实拍截图一律不入库（按 2026-10-23 决定）：shots / shots-after / shots-cand /
#    shots-noreport / crops 全部排除，另有 35 MB / 77 张在 shots/ ─
/exe-preview/shots*/
/exe-preview/crops/

# ── 内部材料：2026-10-26 仓库转公开时剔除（本地保留，不入库）─────
# 内部决策与踩坑记录，属工作过程材料
/.workbuddy/
# 对第三方商业产品的逆向分析，公开有风险
/REF-*.md

# ── 移交导出物（bundle / 源码 zip，2026-10-26 起）────────
/_handover/

# ── 杂项 ────────────────────────────────────────────────
*.log
/.wbapp_*.genie
# 与本项目无关的修复单（属另一条线）
/CODEX-FIX-*.md
